//question-1
uint
sys_getuptime(void)
{
    uint t;
    acquire(&tickslock);
    t = ticks;
    release(&tickslock);
    return t;
}

//question-2
uint64
sys_activecount(void)
{
    int count = 0;
    struct proc *p;
    for(p = proc; p < &proc[NPROC]; p++) {
        acquire(&p->lock);
        if(p->state != UNUSED)
            count++;
        release(&p->lock);
    }
    return count;
}

//question-3
uint64
sys_lineage(void)
{
    int pid;
    argint(0, &pid);
    struct proc *p;
    struct proc *parent;
    int count = 0;
    char name[16];

    for(p = proc; p < &proc[NPROC]; p++) {
        acquire(&p->lock);
        if(p->state != UNUSED && p->pid == pid)
            break;
        release(&p->lock);
    }
    if(p == &proc[NPROC])
        return -1;
    while(1) {
        int current_pid = p->pid;
        safestrcpy(name, p->name, sizeof(name));
        parent = p->parent;
        release(&p->lock);
        printk("PID %d: %s\n", current_pid, name);
        count++;
        if(current_pid == 1)
            break;
        if(parent == 0)
            break;
        p = parent;
        acquire(&p->lock);
        if(p->state == UNUSED) {
            release(&p->lock);
            break;
        }
    }
    return count;
}

//question 4
uint64
sys_getprocsize(void)
{
    int pid;
    argint(0, &pid);
    struct proc *p;
    for(p = proc; p < &proc[NPROC]; p++) {
        acquire(&p->lock);
        if(p->state != UNUSED && p->pid == pid) {
            uint64 size = p->sz;
            release(&p->lock);
            return size;
        }
        release(&p->lock);
    }
    return -1;
}

//question 5
uint64
sys_familyheadcount(void)
{
    int pid;
    argint(0, &pid);
    int count = 0;
    struct proc *p;
    for(p = proc; p < &proc[NPROC]; p++) {
        acquire(&p->lock);
        if(p->state != UNUSED &&
           p->state != ZOMBIE &&
           p->parent != 0 &&
           p->parent->pid == pid) {
            count++;
        }
        release(&p->lock);
    }
    return count;
}
